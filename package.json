  "type": "module",
  "license": "MIT",
  "author": "Kilyakus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kilyakus/framework-preparatorio.git"
  },
  "homepage": "https://github.com/Kilyakus/framework-preparatorio#readme",
  "bugs": {
    "url": "https://github.com/Kilyakus/framework-preparatorio/issues"
  },
  "keywords": [
    "framework",
    "studio",
    "editor",
    "scope",
    "dock",
    "lumino",
    "preparatorio"
