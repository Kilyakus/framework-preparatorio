{
  "name": "framework-preparatorio",
  "version": "1.4.0",
  "description": "Каркас интерфейса редактора на областях (scope): реестр областей, связывание паспорта с реализацией, доступность элементов управления, меню тулбара и справка из вкладов областей, загрузка каталога областей, сборка приложения из движков; ядро приложения: модули, контейнер компонентов, события и конфигурация",
  "type": "module",
  "license": "MIT",
  "author": "Kilyakus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kilyakus/framework-preparatorio.git"
  },
  "homepage": "https://github.com/Kilyakus/framework-preparatorio#readme",
  "bugs": {
    "url": "https://github.com/Kilyakus/framework-preparatorio/issues"
  },
  "keywords": [
    "container",
    "dock",
    "editor",
    "framework",
    "help",
    "kernel",
    "lumino",
    "module",
    "preparatorio",
    "runtime",
    "scope",
    "studio",
    "topbar"
  ],
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/app/main.js",
    "./browser": "./src/app/browser.js",
    "./scopes": "./src/studio/scopes/index.js",
    "./scopes/viewport3d": "./src/studio/scopes/viewport3d/index.js",
    "./scopes/viewport3d/styles.css": "./src/web/assets/css/viewport3d.css",
    "./contributions": "./src/studio/contributions/view-contributions.js",
    "./menu": "./src/studio/menu/index.js",
    "./topbar": "./src/studio/topbar/index.js",
    "./help": "./src/studio/help/index.js",
    "./runtime": "./src/studio/runtime/index.js",
    "./shell": "./src/studio/shell/index.js",
    "./composition": "./src/app/composition/index.js",
    "./core": "./src/core/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {},
  "peerDependencies": {
    "uix-preparatorio": ">=2.0.3"
  },
  "peerDependenciesMeta": {
    "uix-preparatorio": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "devDependencies": {
    "three": "^0.186.1",
    "jsdom": "^26.1.0"
  }
}
